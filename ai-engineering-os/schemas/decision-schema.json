{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngineeringDecision",
  "description": "Schema for architecture and technology decisions",
  "type": "object",
  "required": ["decision_id", "category", "context", "options", "selected_option", "rationale"],
  "properties": {
    "decision_id": { "type": "string", "description": "Unique identifier" },
    "category": { "type": "string", "enum": ["technology", "architecture", "pattern", "infrastructure"] },
    "status": { "type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"], "default": "proposed" },
    "context": {
      "type": "object",
      "properties": {
        "organization_size": { "type": "string", "enum": ["startup", "mid", "enterprise"] },
        "team_expertise": { "type": "string", "enum": ["novice", "intermediate", "expert"] },
        "team_size": { "type": "string" },
        "time_constraints": { "type": "string", "enum": ["prototype", "mvp", "production"] },
        "budget_constraints": { "type": "string", "enum": ["minimal", "moderate", "unlimited"] }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "hard": { "type": "array", "items": { "type": "string" } },
        "soft": { "type": "array", "items": { "type": "string" } },
        "anti": { "type": "array", "items": { "type": "string" } }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "scores": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 1, "maximum": 5 }
          },
          "pros": { "type": "array", "items": { "type": "string" } },
          "cons": { "type": "array", "items": { "type": "string" } }
        }
      },
      "minItems": 1
    },
    "selected_option": { "type": "string" },
    "rationale": { "type": "string" },
    "confidence": { "type": "number", "minimum": 1, "maximum": 5 },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "probability": { "type": "string", "enum": ["low", "medium", "high"] },
          "impact": { "type": "string", "enum": ["low", "medium", "high"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
